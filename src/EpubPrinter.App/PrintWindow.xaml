<Window x:Class="EpubPrinter.App.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/EpubPrinter;component/Assets/app.ico"
        Title="Print"
        Height="900" Width="1120"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="16,14,12,14">

            <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock x:Name="SummaryText" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Button x:Name="PrintButton" Content="Print" Height="36" FontWeight="SemiBold" Click="OnPrint" />
                    <Button Content="Cancel" Height="30" Margin="0,8,0,0" Click="OnCancel" />
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Printer" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox x:Name="PrinterBox" DisplayMemberPath="FullName" SelectionChanged="OnPrinterChanged" />

                    <TextBlock Text="Copies" FontWeight="SemiBold" Margin="0,14,0,4" />
                    <TextBox x:Name="CopiesBox" Text="1" PreviewTextInput="OnDigitsOnly" TextChanged="OnCopiesChanged" />

                    <TextBlock Text="Paper" FontWeight="SemiBold" Margin="0,14,0,4" />
                    <ComboBox x:Name="PaperBox" SelectionChanged="OnSelectionChanged" />

                    <TextBlock Text="Orientation" FontWeight="SemiBold" Margin="0,14,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="PortraitRadio" Content="Portrait" GroupName="Orientation"
                                     IsChecked="True" Checked="OnLayoutChanged" Margin="0,0,16,0" />
                        <RadioButton x:Name="LandscapeRadio" Content="Landscape" GroupName="Orientation"
                                     Checked="OnLayoutChanged" />
                    </StackPanel>

                    <TextBlock Text="Sides" FontWeight="SemiBold" Margin="0,14,0,4" />
                    <ComboBox x:Name="DuplexBox" SelectionChanged="OnSelectionChanged" />
                    <TextBlock x:Name="DuplexNote" Foreground="#777" TextWrapping="Wrap"
                               Margin="0,4,0,0" FontSize="11" Visibility="Collapsed" />

                    <TextBlock Text="Pages per side" FontWeight="SemiBold" Margin="0,14,0,4" />
                    <ComboBox x:Name="PagesPerSheetBox" SelectionChanged="OnSelectionChanged" />

                    <TextBlock Text="Scale" FontWeight="SemiBold" Margin="0,14,0,4" />
                    <ComboBox x:Name="ScaleBox" SelectionChanged="OnSelectionChanged" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="ScaleSlider" Minimum="25" Maximum="200" TickFrequency="5"
                                IsSnapToTickEnabled="True" Value="100" ValueChanged="OnScaleSliderChanged"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ElementName=ScaleSlider, Path=Value, StringFormat={}{0:0}%}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="42" />
                    </Grid>
                    <TextBlock Text="Smaller scale fits more text on each sheet."
                               Foreground="#777" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11" />

                    <TextBlock Text="On every page" FontWeight="SemiBold" Margin="0,14,0,4" />
                    <CheckBox x:Name="PageNumbersCheck" Content="Page numbers" Margin="0,2"
                              Checked="OnLayoutChanged" Unchecked="OnLayoutChanged" />
                    <CheckBox x:Name="RunningHeaderCheck" Content="Book title header" Margin="0,2"
                              Checked="OnLayoutChanged" Unchecked="OnLayoutChanged" />

                    <TextBlock Text="Margins" FontWeight="SemiBold" Margin="0,14,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="MarginSlider" Minimum="0.25" Maximum="2" TickFrequency="0.25"
                                IsSnapToTickEnabled="True" Value="0.75" ValueChanged="OnMarginChanged"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ElementName=MarginSlider, Path=Value, StringFormat={}{0:0.00} in}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="58" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <Grid Grid.Column="1" Background="#F3F3F6">
            <DocumentViewer x:Name="Viewer" />
            <Border x:Name="BusyOverlay" Background="#B0FFFFFF" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="BusyText" Text="Rendering preview..." FontSize="15" HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Width="220" Height="6" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>




